            "summary": {
                "total_phases": len(program_results["phases"]),
                "total_agents": program_results["total_agents"],
                "successful_agents": program_results["successful_agents"],
                "failed_agents": program_results["failed_agents"],
                "blocked_agents": program_results["blocked_agents"],
                "overall_success_rate": (
                    program_results["successful_agents"] / program_results["total_agents"] * 100
                ) if program_results["total_agents"] > 0 else 0,
            },
            "phases": {},
            "critical_findings": [],
            "recommendations": [],
            "next_steps": [],
        }
        
        # Add phase details
        for phase_id, phase_data in program_results["phases"].items():
            report["phases"][phase_id] = {
                "name": self.phases[phase_id]["name"],
                "summary": phase_data["summary"],
                "agent_results": phase_data["results"],
            }
        
        # Generate critical findings
        for phase_id, phase_data in program_results["phases"].items():
            for agent_id, agent_result in phase_data["results"].items():
                if agent_result["status"] == "failed":
                    report["critical_findings"].append({
                        "phase": phase_id,
                        "agent": agent_id,
                        "issue": "Agent execution failed",
                        "severity": "HIGH"
                    })
        
        # Generate recommendations
        if program_results["failed_agents"] > 0:
            report["recommendations"].append(
                "Investigate and fix failed agents before production deployment"
            )
        
        if program_results["blocked_agents"] > 0:
            report["recommendations"].append(
                "Resolve agent dependencies to unblock execution"
            )
        
        report["recommendations"].extend([
            "Conduct security review of all hardened components",
            "Perform penetration testing on the secured system",
            "Establish ongoing security monitoring",
            "Schedule regular security updates and patches",
        ])
        
        # Define next steps
        if program_results["overall_status"] == "completed":
            report["next_steps"] = [
                "Deploy secured system to staging environment",
                "Conduct integration testing",
                "Validate security controls",
                "Deploy to production with monitoring",
            ]
        else:
            report["next_steps"] = [
                "Review and fix failed agents",
                "Re-run the security hardening program",
                "Validate fixes before proceeding",
            ]
        
        return report
    
    async def _save_program_report(self, program_results: Dict[str, Any]):
        """Save program report to file"""
        try:
            report_file = SECURITY_DIR / f"security_program_report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
            
            with open(report_file, 'w', encoding='utf-8') as f:
                json.dump(program_results, f, indent=2, ensure_ascii=False)
            
            print(f"📄 Program report saved to: {report_file}")
            
        except Exception as e:
            print(f"⚠️ Failed to save program report: {e}")
    
    async def get_program_status(self) -> Dict[str, Any]:
        """Get current program status"""
        return {
            "program_status": self.program_status.value,
            "phases_completed": len(self.execution_history),
            "total_phases": len(self.phases),
            "execution_history": [
                {
                    "phase": entry["phase"],
                    "timestamp": entry["timestamp"],
                    "agent_count": len(entry["results"])
                }
                for entry in self.execution_history
            ]
        }

