    def _create_input_size_limiter(self):
        """Create middleware to limit input size"""
        def input_size_limiter(max_size: int = SECURITY_CONFIG["max_request_size"]):
            async def middleware(request, handler):
                # Check content length if available
                content_length = request.headers.get('Content-Length')
                if content_length:
                    size = int(content_length)
                    if size > max_size:
                        raise ValueError(f"Request too large: {size} > {max_size}")
                
                # For streaming requests, we'd need to check as we read
                return await handler(request)
            
            return middleware
        
        return input_size_limiter
    
    def _create_content_type_validator(self):
        """Create middleware to validate content types"""
        def content_type_validator(allowed_types: List[str] = None):
            if allowed_types is None:
                allowed_types = [
                    'application/json',
                    'application/x-www-form-urlencoded',
                    'multipart/form-data'
                ]
            
            async def middleware(request, handler):
                content_type = request.headers.get('Content-Type', '')
                
                # Check if content type is allowed
                if content_type and not any(
                    allowed in content_type for allowed in allowed_types
                ):
                    raise ValueError(f"Unsupported content type: {content_type}")
                
                return await handler(request)
            
            return middleware
        
        return content_type_validator
    
    def _create_header_security_middleware(self):
        """Create middleware to add security headers"""
        def header_security():
            async def middleware(request, handler):
                response = await handler(request)
                
                # Add security headers
                response.headers.update({
                    'X-Content-Type-Options': 'nosniff',
                    'X-Frame-Options': 'DENY',
                    'X-XSS-Protection': '1; mode=block',
                    'Strict-Transport-Security': 'max-age=31536000; includeSubDomains',
                    'Content-Security-Policy': "default-src 'self'",
                    'Referrer-Policy': 'strict-origin-when-cross-origin',
                    'Permissions-Policy': 'geolocation=(), microphone=(), camera=()'
                })
                
                return response
            
            return middleware
        
        return header_security
    
    def _create_cors_protection(self):
        """Create CORS protection middleware"""
        def cors_protection(allowed_origins: List[str] = None):
            if allowed_origins is None:
                allowed_origins = []  # Same-origin by default
            
            async def middleware(request, handler):
                origin = request.headers.get('Origin')
                
                if origin and origin not in allowed_origins:
                    raise ValueError(f"CORS policy violation: {origin}")
                
                response = await handler(request)
                
                # Add CORS headers if origin is allowed
                if origin in allowed_origins:
                    response.headers.update({
                        'Access-Control-Allow-Origin': origin,
                        'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
                        'Access-Control-Allow-Headers': 'Content-Type, Authorization',
                        'Access-Control-Allow-Credentials': 'true',
                        'Access-Control-Max-Age': '86400',
                    })
                
                return response
            
            return middleware
        
        return cors_protection
    
