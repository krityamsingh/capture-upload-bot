    async def check_proxy_health(self, proxy_url: str) -> Dict[str, Any]:
        """
        Check proxy health with comprehensive testing
        """
        health_data = {
            "proxy_url": proxy_url,
            "timestamp": datetime.now().isoformat(),
            "tests_passed": 0,
            "tests_failed": 0,
            "response_times": [],
            "errors": [],
            "score": 0,
        }
        
        try:
            # Test each endpoint
            for endpoint in self.test_endpoints:
                test_result = await self._test_proxy_endpoint(proxy_url, endpoint)
                
                if test_result["success"]:
                    health_data["tests_passed"] += 1
                    health_data["response_times"].append(test_result["response_time"])
                else:
                    health_data["tests_failed"] += 1
                    health_data["errors"].append(test_result["error"])
            
            # Calculate health score
            if health_data["tests_passed"] > 0:
                avg_response = sum(health_data["response_times"]) / len(health_data["response_times"])
                success_rate = health_data["tests_passed"] / (health_data["tests_passed"] + health_data["tests_failed"])
                
                # Simple scoring formula
                response_score = max(0, 100 - (avg_response * 10))
                success_score = success_rate * 100
                health_data["score"] = (response_score * 0.4) + (success_score * 0.6)
            
            # Update metrics
            self.metrics["health_checks_performed"] += 1
            
            # Check if proxy should be quarantined
            if health_data["score"] < 40:
                await self.quarantine_proxy(proxy_url, "low_health_score", 3600)
            
            return health_data
            
        except Exception as e:
            health_data["errors"].append(str(e))
            self.metrics["connection_errors"] += 1
            return health_data
    
    async def _test_proxy_endpoint(self, proxy_url: str, endpoint: Dict) -> Dict[str, Any]:
        """Test proxy against a specific endpoint"""
        result = {
            "success": False,
            "response_time": 0,
            "error": None,
        }
        
        try:
            start_time = time.time()
            
            # Create connector with proxy
            connector = aiohttp.TCPConnector(ssl=False)
            
            async with aiohttp.ClientSession(connector=connector) as session:
                async with session.get(
                    endpoint["url"],
                    proxy=proxy_url,
                    timeout=aiohttp.ClientTimeout(total=endpoint["timeout"])
                ) as response:
                    if response.status == 200:
                        result["success"] = True
                    else:
                        result["error"] = f"HTTP {response.status}"
            
            result["response_time"] = time.time() - start_time
            
        except asyncio.TimeoutError:
            result["error"] = f"Timeout after {endpoint['timeout']}s"
        except Exception as e:
            result["error"] = str(e)
        
        return result
    
    async def quarantine_proxy(self, proxy_url: str, reason: str, duration: int):
        """
        Quarantine a problematic proxy
        """
        # Add to quarantine list
        self.quarantine_list.add(proxy_url)
        
        # Store in Redis
        quarantine_key = "proxy_quarantine_list"
        await self.redis_safeguards.store_state(
            quarantine_key,
            {"proxies": list(self.quarantine_list)},
            ttl=duration
        )
        
        # Create quarantine record
        record_key = f"proxy_quarantine:{hashlib.md5(proxy_url.encode()).hexdigest()[:8]}"
        record = {
            "proxy_url": proxy_url,
            "reason": reason,
            "quarantined_at": datetime.now().isoformat(),
            "expires_at": (datetime.now() + timedelta(seconds=duration)).isoformat(),
            "duration": duration,
        }
        
        await self.redis_safeguards.store_state(
            record_key,
            record,
            ttl=duration
        )
        
        self.metrics["proxies_quarantined"] += 1
        
        if self.audit_logger:
            await self.audit_logger.log_event(
                event_type=SecurityEventType.SECURITY_ALERT,
                threat_level=ThreatLevel.MEDIUM,
                source=self.agent_id,
                description=f"Proxy quarantined: {reason}",
                details={"proxy_url": proxy_url, "reason": reason, "duration": duration}
            )
        
        print(f"  🚫 Proxy quarantined: {proxy_url} ({reason})")
    
    async def rotate_proxy(self, current_proxy: str = None, reason: str = None) -> Optional[str]:
        """
        Rotate to a new proxy based on policies
        """
        # Get available proxies (in production, this would come from a database)
        available_proxies = await self._get_available_proxies()
        
        if not available_proxies:
            return None
        
        # Filter out quarantined proxies
        available_proxies = [p for p in available_proxies if p not in self.quarantine_list]
        
        if not available_proxies:
            return None
        
        # Select best proxy based on health scores
        best_proxy = None
        best_score = -1
        
        for proxy in available_proxies:
            # Get health score (in production, this would be cached)
            health_data = await self.check_proxy_health(proxy)
            score = health_data.get("score", 0)
            
            if score > best_score:
                best_score = score
                best_proxy = proxy
        
        if best_proxy and best_proxy != current_proxy:
            self.metrics["proxies_rotated"] += 1
            
            if self.audit_logger and reason:
                await self.audit_logger.log_event(
                    event_type=SecurityEventType.SECURITY_ALERT,
                    threat_level=ThreatLevel.INFO,
                    source=self.agent_id,
                    description=f"Proxy rotated: {reason}",
                    details={
                        "old_proxy": current_proxy,
                        "new_proxy": best_proxy,
                        "reason": reason,
                        "health_score": best_score
                    }
                )
        
        return best_proxy
    
