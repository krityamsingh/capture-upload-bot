    def _create_request_validator_middleware(self):
        """Create request validation middleware"""
        def request_validator():
            async def middleware(request, handler):
                # Validate request method
                valid_methods = ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
                if request.method not in valid_methods:
                    raise ValueError(f"Invalid HTTP method: {request.method}")
                
                # Validate path (no path traversal)
                path = request.path
                if '..' in path or '//' in path:
                    raise ValueError(f"Path traversal attempt: {path}")
                
                # Validate headers
                headers = dict(request.headers)
                for header_name, header_value in headers.items():
                    # Check for suspicious headers
                    suspicious_headers = ['x-forwarded-for', 'x-real-ip', 'x-forwarded-host']
                    if header_name.lower() in suspicious_headers:
                        # Log suspicious header but don't block
                        if self.audit_logger:
                            await self.audit_logger.log_event(
                                event_type=SecurityEventType.INPUT_VALIDATION,
                                threat_level=ThreatLevel.LOW,
                                source=self.agent_id,
                                description=f"Suspicious header detected: {header_name}",
                                details={"header_name": header_name, "header_value": header_value[:100]}
                            )
                
                return await handler(request)
            
            return middleware
        
        return request_validator
    
    def _create_sql_injection_protector(self):
        """Create SQL injection protection middleware"""
        def sql_injection_protector():
            async def middleware(request, handler):
                # Check request parameters for SQL injection patterns
                sql_patterns = [
                    r'(\'|\"|`).*(\'|\"|`).*(SELECT|INSERT|UPDATE|DELETE|DROP|UNION)',
                    r';.*--',
                    r'/\*.*\*/',
                    r'exec(\s|\()+',
                    r'xp_cmdshell',
                    r'waitfor\s+delay',
                ]
                
                # Check query parameters
                query_params = dict(request.query)
                for param_name, param_value in query_params.items():
                    if isinstance(param_value, str):
                        for pattern in sql_patterns:
                            if re.search(pattern, param_value, re.IGNORECASE):
                                raise ValueError(f"Potential SQL injection in parameter: {param_name}")
                
                # Check JSON body if present
                try:
                    if request.can_read_body:
                        body = await request.json()
                        if isinstance(body, dict):
                            for key, value in body.items():
                                if isinstance(value, str):
                                    for pattern in sql_patterns:
                                        if re.search(pattern, value, re.IGNORECASE):
                                            raise ValueError(f"Potential SQL injection in body field: {key}")
                except:
                    pass  # Not JSON or can't parse
                
                return await handler(request)
            
            return middleware
        
        return sql_injection_protector
    
    def _create_xss_protector(self):
        """Create XSS protection middleware"""
        def xss_protector():
            async def middleware(request, handler):
                # Check for XSS patterns in input
                xss_patterns = [
                    r'<script[^>]*>',
                    r'javascript:',
                    r'onload\s*=',
                    r'onerror\s*=',
                    r'onclick\s*=',
                    r'vbscript:',
                    r'expression\s*\(',
                ]
                
                # Check query parameters
                query_params = dict(request.query)
                for param_name, param_value in query_params.items():
                    if isinstance(param_value, str):
                        for pattern in xss_patterns:
                            if re.search(pattern, param_value, re.IGNORECASE):
                                raise ValueError(f"Potential XSS in parameter: {param_name}")
                
                return await handler(request)
            
            return middleware
        
        return xss_protector
    
