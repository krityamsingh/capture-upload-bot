    def _build_dependency_graph(self):
        """Build dependency graph for all agents"""
        self.dependencies = {}
        
        for phase_id, phase_info in self.phases.items():
            for agent_id in phase_info["agents"]:
                if agent_id in phase_info.get("dependencies", {}):
                    self.dependencies[agent_id] = phase_info["dependencies"][agent_id]
                else:
                    self.dependencies[agent_id] = []
    
    async def execute_phase(self, phase_id: str) -> Dict[str, AgentResult]:
        """
        Execute a specific phase with proper sequencing
        """
        if phase_id not in self.phases:
            raise ValueError(f"Unknown phase: {phase_id}")
        
        phase = self.phases[phase_id]
        results = {}
        
        print(f"🚀 Starting {phase['name']}...")
        
        # Check phase dependencies
        if not await self._check_phase_dependencies(phase_id):
            print(f"❌ Phase {phase_id} dependencies not met")
            return results
        
        # Get agents for this phase
        phase_agents = [
            agent_id for agent_id in phase["agents"] 
            if self.agents.get(agent_id) is not None
        ]
        
        # Check for parallel execution opportunities
        parallel_groups = phase.get("parallel_allowed", [])
        
        if parallel_groups:
            # Execute parallel groups
            for group in parallel_groups:
                group_agents = [a for a in group if a in phase_agents]
                if group_agents:
                    await self._execute_agents_parallel(group_agents, results)
        else:
            # Execute sequentially
            for agent_id in phase_agents:
                if agent_id not in results:  # Skip if already executed in parallel group
                    await self._execute_agent(agent_id, results)
        
        # Check phase completion
        phase_success = all(
            result.status == AgentStatus.COMPLETED 
            for result in results.values()
        )
        
        if phase_success:
            print(f"✅ {phase['name']} completed successfully")
            
            await self.audit_logger.log_event(
                event_type=SecurityEventType.AGENT_COMPLETE,
                threat_level=ThreatLevel.INFO,
                source="ProgramManager",
                description=f"Phase completed: {phase['name']}",
                details={
                    "phase_id": phase_id,
                    "agents_executed": len(results),
                    "success_rate": f"{len([r for r in results.values() if r.status == AgentStatus.COMPLETED])}/{len(results)}"
                }
            )
        else:
            print(f"⚠️ {phase['name']} completed with issues")
        
        return results
    
    async def _check_phase_dependencies(self, phase_id: str) -> bool:
        """Check if all dependencies for a phase are met"""
        phase = self.phases[phase_id]
        
        # Check if previous phases are complete
        phase_order = list(self.phases.keys())
        current_index = phase_order.index(phase_id)
        
        if current_index > 0:
            previous_phase = phase_order[current_index - 1]
            previous_results = [
                entry for entry in self.execution_history
                if entry["phase"] == previous_phase
            ]
            
            if not previous_results:
                print(f"⚠️ Previous phase {previous_phase} not executed")
                return False
            
            # Check if previous phase was successful
            last_execution = previous_results[-1]
            phase_success = all(
                result.status == AgentStatus.COMPLETED
                for result in last_execution["results"].values()
            )
            
            if not phase_success:
                print(f"⚠️ Previous phase {previous_phase} did not complete successfully")
                return False
        
        return True
    
    async def _execute_agents_parallel(self, agent_ids: List[str], results: Dict[str, AgentResult]):
        """Execute multiple agents in parallel"""
        tasks = []
        
        for agent_id in agent_ids:
            if agent_id in self.agents and self.agents[agent_id] is not None:
                # Check agent dependencies
                if await self._check_agent_dependencies(agent_id, results):
                    task = asyncio.create_task(
                        self._execute_single_agent(agent_id, results)
                    )
                    tasks.append(task)
                else:
                    print(f"⚠️ Agent {agent_id} dependencies not met, skipping")
        
        if tasks:
            await asyncio.gather(*tasks, return_exceptions=True)
    
    async def _execute_agent(self, agent_id: str, results: Dict[str, AgentResult]):
        """Execute a single agent"""
        if agent_id in self.agents and self.agents[agent_id] is not None:
            # Check agent dependencies
            if await self._check_agent_dependencies(agent_id, results):
                await self._execute_single_agent(agent_id, results)
            else:
                print(f"⚠️ Agent {agent_id} dependencies not met, skipping")
                results[agent_id] = AgentResult(
                    agent_id=agent_id,
                    status=AgentStatus.BLOCKED,
                    start_time=datetime.now(),
                    end_time=datetime.now(),
                    errors=[f"Dependencies not met: {self.dependencies.get(agent_id, [])}"]
                )
    
    async def _check_agent_dependencies(self, agent_id: str, results: Dict[str, AgentResult]) -> bool:
        """Check if all dependencies for an agent are met"""
        dependencies = self.dependencies.get(agent_id, [])
        
        for dep_agent_id in dependencies:
            if dep_agent_id not in results:
                return False
            
            if results[dep_agent_id].status != AgentStatus.COMPLETED:
                return False
        
        return True
    
    async def _execute_single_agent(self, agent_id: str, results: Dict[str, AgentResult]):
        """Execute a single agent and store result"""
        agent = self.agents[agent_id]
        
        print(f"  🚀 Starting agent: {agent_id}")
        
        # Special handling for different agent types
        if agent_id == "redis_safeguards_agent":
            result = await agent.initialize()
            agent_result = AgentResult(
                agent_id=agent_id,
                status=AgentStatus.COMPLETED if result else AgentStatus.FAILED,
                start_time=datetime.now(),
                end_time=datetime.now(),
                errors=[] if result else ["Redis initialization failed"]
            )
            self.redis_safeguards = agent if result else None
        elif agent_id == "audit_logging_agent":
            # Audit logger doesn't need execution
            agent_result = AgentResult(
                agent_id=agent_id,
                status=AgentStatus.COMPLETED,
                start_time=datetime.now(),
                end_time=datetime.now()
            )
        elif hasattr(agent, 'execute'):
            # Standard agent with execute method
            dependencies = self.dependencies.get(agent_id, [])
            agent_result = await agent.execute(dependencies)
        else:
            agent_result = AgentResult(
                agent_id=agent_id,
                status=AgentStatus.SKIPPED,
                start_time=datetime.now(),
                end_time=datetime.now(),
                errors=["Agent not implemented"]
            )
        
        results[agent_id] = agent_result
        
        # Log execution result
        if agent_result.status == AgentStatus.COMPLETED:
            print(f"  ✅ Agent completed: {agent_id}")
        elif agent_result.status == AgentStatus.FAILED:
            print(f"  ❌ Agent failed: {agent_id}")
            for error in agent_result.errors:
                print(f"    Error: {error}")
    
