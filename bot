class RedisSafeguards:
    """
    REDIS STATE MANAGEMENT WITH SAFEGUARDS
    OTP safety, state consistency, TTL enforcement, race-condition protection
    """
    
    def __init__(self, redis_config: Dict = None, audit_logger: AuditLogger = None):
        self.config = redis_config or REDIS_CONFIG
        self.audit_logger = audit_logger
        self.redis_client: Optional[redis.Redis] = None
        self.key_prefix = "sec:"
        
        # Safeguard configurations
        self.safeguards = {
            "max_otp_attempts": 3,
            "otp_ttl": 300,  # 5 minutes
            "session_ttl": 3600,  # 1 hour
            "lock_ttl": 30,  # Lock timeout
            "max_concurrent_locks": 5,
            "data_encryption": True,
            "compression": True,
            "backup_enabled": True,
            "backup_interval": 3600,  # 1 hour
        }
        
        # Metrics
        self.metrics = {
            "total_operations": 0,
            "failed_operations": 0,
            "race_conditions_prevented": 0,
            "otp_verifications": 0,
            "otp_failures": 0,
            "locks_acquired": 0,
            "locks_failed": 0,
        }
    
    async def initialize(self) -> bool:
        """Initialize Redis connection and setup safeguards"""
        try:
            # Create Redis connection pool
            connection_pool = redis.ConnectionPool.from_url(
                f"redis://{self.config['host']}:{self.config['port']}/{self.config['db']}",
                password=self.config.get('password'),
                ssl=self.config.get('ssl', False),
                max_connections=self.config.get('max_connections', 20),
                socket_timeout=self.config.get('socket_timeout', 5),
                retry_on_timeout=self.config.get('retry_on_timeout', True),
            )
            
            self.redis_client = redis.Redis(
                connection_pool=connection_pool,
                decode_responses=True
            )
            
            # Test connection
            await self.redis_client.ping()
            
            # Load existing safeguards
            await self._load_safeguards()
            
            # Start background tasks
            asyncio.create_task(self._background_maintenance())
            
            if self.audit_logger:
                await self.audit_logger.log_event(
                    event_type=SecurityEventType.SYSTEM_START,
                    threat_level=ThreatLevel.INFO,
                    source="RedisSafeguards",
                    description="Redis safeguards initialized successfully"
                )
            
            print("✅ Redis safeguards initialized")
            return True
            
        except Exception as e:
            print(f"❌ Redis initialization failed: {e}")
            return False
    
    async def _load_safeguards(self):
        """Load safeguard configurations from Redis"""
        try:
            safeguard_key = f"{self.key_prefix}safeguards:config"
            config = await self.redis_client.get(safeguard_key)
            if config:
                loaded = json.loads(config)
                self.safeguards.update(loaded)
        except Exception:
            pass  # Use defaults if loading fails
    
    async def _background_maintenance(self):
        """Background maintenance tasks"""
        while True:
            try:
                # Cleanup expired locks
                await self._cleanup_expired_locks()
                
                # Backup safeguards config
                if self.safeguards["backup_enabled"]:
                    await self._backup_safeguards()
                
                # Update metrics
                await self._update_metrics()
                
            except Exception as e:
                print(f"⚠️ Redis maintenance error: {e}")
            
            await asyncio.sleep(self.safeguards["backup_interval"])
    
    async def _cleanup_expired_locks(self):
        """Cleanup expired distributed locks"""
        try:
            lock_pattern = f"{self.key_prefix}lock:*"
            cursor = 0
            deleted = 0
            
            while True:
                cursor, keys = await self.redis_client.scan(
                    cursor=cursor,
                    match=lock_pattern,
                    count=100
                )
                
                for key in keys:
                    ttl = await self.redis_client.ttl(key)
                    if ttl < 0:  # Expired
                        await self.redis_client.delete(key)
                        deleted += 1
                
                if cursor == 0:
                    break
            
            if deleted > 0:
                print(f"🧹 Cleaned up {deleted} expired locks")
                
        except Exception as e:
            print(f"⚠️ Lock cleanup error: {e}")
    
    async def _backup_safeguards(self):
        """Backup safeguard configurations"""
        try:
            backup_key = f"{self.key_prefix}safeguards:backup:{int(time.time())}"
            backup_data = {
                "config": self.safeguards,
                "metrics": self.metrics,
                "timestamp": datetime.now().isoformat()
            }
            
            await self.redis_client.setex(
                backup_key,
                86400 * 7,  # Keep for 7 days
                json.dumps(backup_data)
            )
            
        except Exception as e:
            print(f"⚠️ Safeguard backup error: {e}")
    
    async def _update_metrics(self):
        """Update Redis metrics"""
        try:
            metrics_key = f"{self.key_prefix}metrics"
            await self.redis_client.setex(
                metrics_key,
                300,  # 5 minutes TTL
                json.dumps({
                    **self.metrics,
                    "updated_at": datetime.now().isoformat()
                })
            )
        except Exception as e:
            print(f"⚠️ Metrics update error: {e}")
    
    async def store_otp(self, identifier: str, otp: str, metadata: Dict = None) -> bool:
        """
        Store OTP with safeguards against brute force
        """
        try:
            otp_key = f"{self.key_prefix}otp:{identifier}"
            
            # Check existing attempts
            attempts_key = f"{self.key_prefix}otp_attempts:{identifier}"
            attempts = await self.redis_client.get(attempts_key) or 0
            attempts = int(attempts)
            
            if attempts >= self.safeguards["max_otp_attempts"]:
                if self.audit_logger:
                    await self.audit_logger.log_event(
                        event_type=SecurityEventType.RATE_LIMIT,
                        threat_level=ThreatLevel.MEDIUM,
                        source="RedisSafeguards",
                        description=f"OTP attempt limit exceeded for {identifier}",
                        details={"attempts": attempts, "max_attempts": self.safeguards["max_otp_attempts"]}
                    )
                return False
            
            # Store OTP with metadata
            otp_data = {
                "otp": otp,
                "created_at": datetime.now().isoformat(),
                "expires_at": (datetime.now() + timedelta(seconds=self.safeguards["otp_ttl"])).isoformat(),
                "attempts": 0,
                "metadata": metadata or {}
            }
            
            # Use transaction for atomic operations
            async with self.redis_client.pipeline(transaction=True) as pipe:
                pipe.setex(otp_key, self.safeguards["otp_ttl"], json.dumps(otp_data))
                pipe.setex(attempts_key, self.safeguards["otp_ttl"], 0)
                await pipe.execute()
            
            self.metrics["otp_verifications"] += 1
            
            if self.audit_logger:
                await self.audit_logger.log_event(
                    event_type=SecurityEventType.AUTH_SUCCESS,
                    threat_level=ThreatLevel.INFO,
                    source="RedisSafeguards",
                    description=f"OTP stored for {identifier}",
                    details={"identifier": identifier, "ttl": self.safeguards["otp_ttl"]}
                )
            
            return True
            
        except Exception as e:
            print(f"❌ OTP storage failed: {e}")
            self.metrics["failed_operations"] += 1
            return False
    
    async def verify_otp(self, identifier: str, otp: str) -> Tuple[bool, Dict]:
        """
        Verify OTP with rate limiting and attempt tracking
        """
        try:
            otp_key = f"{self.key_prefix}otp:{identifier}"
            attempts_key = f"{self.key_prefix}otp_attempts:{identifier}"
            
            # Get OTP data
            otp_data_str = await self.redis_client.get(otp_key)
            if not otp_data_str:
                return False, {"error": "OTP not found or expired"}
            
            otp_data = json.loads(otp_data_str)
            
            # Check attempts
            attempts = await self.redis_client.get(attempts_key) or 0
            attempts = int(attempts)
            
            if attempts >= self.safeguards["max_otp_attempts"]:
                # Delete OTP after max attempts
                await self.redis_client.delete(otp_key)
                
                if self.audit_logger:
                    await self.audit_logger.log_event(
                        event_type=SecurityEventType.AUTH_FAILURE,
                        threat_level=ThreatLevel.HIGH,
                        source="RedisSafeguards",
                        description=f"OTP max attempts reached for {identifier}",
                        details={"attempts": attempts, "max_attempts": self.safeguards["max_otp_attempts"]}
                    )
                
                return False, {"error": "Maximum attempts exceeded"}
            
            # Increment attempts
            await self.redis_client.incr(attempts_key)
            await self.redis_client.expire(attempts_key, self.safeguards["otp_ttl"])
            
            # Verify OTP
            is_valid = hmac.compare_digest(otp_data["otp"], otp)
            
            if is_valid:
                # Clear OTP and attempts on success
                await self.redis_client.delete(otp_key)
                await self.redis_client.delete(attempts_key)
                
                # Update metadata
                otp_data["verified_at"] = datetime.now().isoformat()
                otp_data["attempts"] = attempts + 1
                
                self.metrics["otp_verifications"] += 1
                
                if self.audit_logger:
                    await self.audit_logger.log_event(
                        event_type=SecurityEventType.AUTH_SUCCESS,
                        threat_level=ThreatLevel.INFO,
                        source="RedisSafeguards",
                        description=f"OTP verified successfully for {identifier}",
                        details={"identifier": identifier, "attempts": attempts + 1}
                    )
                
                return True, {"metadata": otp_data.get("metadata", {}), "attempts": attempts + 1}
            else:
                self.metrics["otp_failures"] += 1
                
                if attempts + 1 >= self.safeguards["max_otp_attempts"]:
                    await self.redis_client.delete(otp_key)
                    
                    if self.audit_logger:
                        await self.audit_logger.log_event(
                            event_type=SecurityEventType.AUTH_FAILURE,
                            threat_level=ThreatLevel.HIGH,
                            source="RedisSafeguards",
                            description=f"OTP verification failed with max attempts for {identifier}",
                            details={"attempts": attempts + 1, "max_attempts": self.safeguards["max_otp_attempts"]}
                        )
                
                return False, {
                    "error": "Invalid OTP",
                    "attempts_remaining": self.safeguards["max_otp_attempts"] - (attempts + 1),
                    "attempts": attempts + 1
                }
                
        except Exception as e:
            print(f"❌ OTP verification failed: {e}")
            self.metrics["failed_operations"] += 1
            return False, {"error": str(e)}
    
    async def acquire_lock(self, lock_name: str, timeout: int = None) -> Optional[str]:
        """
        Acquire distributed lock with race condition protection
        """
        try:
            lock_key = f"{self.key_prefix}lock:{lock_name}"
            lock_id = SecurityUtils.generate_secure_token()
            timeout = timeout or self.safeguards["lock_ttl"]
            
            # Try to acquire lock
            acquired = await self.redis_client.set(
                lock_key,
                lock_id,
                ex=timeout,
                nx=True  # Only set if not exists
            )
            
            if acquired:
                self.metrics["locks_acquired"] += 1
                self.metrics["race_conditions_prevented"] += 1
                
                if self.audit_logger:
                    await self.audit_logger.log_event(
                        event_type=SecurityEventType.SESSION_CREATE,
                        threat_level=ThreatLevel.INFO,
                        source="RedisSafeguards",
                        description=f"Lock acquired: {lock_name}",
                        details={"lock_id": lock_id, "timeout": timeout}
                    )
                
                return lock_id
            else:
                self.metrics["locks_failed"] += 1
                return None
                
        except Exception as e:
            print(f"❌ Lock acquisition failed: {e}")
            self.metrics["failed_operations"] += 1
            return None
    
    async def release_lock(self, lock_name: str, lock_id: str) -> bool:
        """
        Release distributed lock safely
        """
        try:
            lock_key = f"{self.key_prefix}lock:{lock_name}"
            
            # Use Lua script for atomic check-and-delete
            lua_script = """
            if redis.call("get", KEYS[1]) == ARGV[1] then
                return redis.call("del", KEYS[1])
            else
                return 0
            end
            """
            
            released = await self.redis_client.eval(
                lua_script,
                1,  # Number of keys
                lock_key,
                lock_id
            )
            
            if released:
                if self.audit_logger:
                    await self.audit_logger.log_event(
                        event_type=SecurityEventType.SESSION_DESTROY,
                        threat_level=ThreatLevel.INFO,
                        source="RedisSafeguards",
                        description=f"Lock released: {lock_name}",
                        details={"lock_id": lock_id}
                    )
                
                return True
            else:
                print(f"⚠️ Lock release failed: Invalid lock ID or already released")
                return False
                
        except Exception as e:
            print(f"❌ Lock release failed: {e}")
            self.metrics["failed_operations"] += 1
            return False
    
    async def store_state(
        self, 
        state_id: str, 
        data: Dict, 
        ttl: int = None,
        encrypt: bool = True
    ) -> bool:
        """
        Store state data with TTL enforcement and optional encryption
        """
        try:
            state_key = f"{self.key_prefix}state:{state_id}"
            ttl = ttl or self.safeguards["session_ttl"]
            
            # Prepare data
            state_data = {
                "data": data,
                "created_at": datetime.now().isoformat(),
                "expires_at": (datetime.now() + timedelta(seconds=ttl)).isoformat(),
                "version": "1.0"
            }
            
            # Optional encryption
            if encrypt and self.safeguards["data_encryption"]:
                # In production, use proper encryption key management
                state_data["encrypted"] = True
                # For demo, we'll just mark it
                pass
            
            # Store with TTL
            await self.redis_client.setex(
                state_key,
                ttl,
                json.dumps(state_data)
            )
            
            self.metrics["total_operations"] += 1
            
            if self.audit_logger:
                await self.audit_logger.log_event(
                    event_type=SecurityEventType.DATA_ACCESS,
                    threat_level=ThreatLevel.INFO,
                    source="RedisSafeguards",
                    description=f"State stored: {state_id}",
                    details={"state_id": state_id, "ttl": ttl, "encrypted": encrypt}
                )
            
            return True
            
        except Exception as e:
            print(f"❌ State storage failed: {e}")
            self.metrics["failed_operations"] += 1
            return False
    
    async def get_state(self, state_id: str) -> Optional[Dict]:
        """
        Retrieve state data with consistency checks
        """
        try:
            state_key = f"{self.key_prefix}state:{state_id}"
            
            # Get state data
            state_data_str = await self.redis_client.get(state_key)
            if not state_data_str:
                return None
            
            state_data = json.loads(state_data_str)
            
            # Check expiration
            expires_at = datetime.fromisoformat(state_data["expires_at"])
            if datetime.now() > expires_at:
                # Auto-cleanup expired state
                await self.redis_client.delete(state_key)
                return None
            
            # Refresh TTL on access (sliding expiration)
            await self.redis_client.expire(
                state_key,
                self.safeguards["session_ttl"]
            )
            
            self.metrics["total_operations"] += 1
            
            return state_data.get("data", {})
            
        except Exception as e:
            print(f"❌ State retrieval failed: {e}")
            self.metrics["failed_operations"] += 1
            return None
    
    async def delete_state(self, state_id: str) -> bool:
        """
        Delete state data securely
        """
        try:
            state_key = f"{self.key_prefix}state:{state_id}"
            
            deleted = await self.redis_client.delete(state_key)
            
            if deleted:
                if self.audit_logger:
                    await self.audit_logger.log_event(
                        event_type=SecurityEventType.DATA_ACCESS,
                        threat_level=ThreatLevel.INFO,
                        source="RedisSafeguards",
