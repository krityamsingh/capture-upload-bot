class AuditLogger:
    """
    SECURE AUDIT LOGGING SYSTEM
    Comprehensive logging with redaction, signing, and compliance features
    """
    
    def __init__(self, log_level: LoggingLevel = LoggingLevel.STANDARD):
        self.log_level = log_level
        self.events: List[SecurityEvent] = []
        self.redaction_patterns = [
            r'password[=:]\s*([^\s&]+)',
            r'token[=:]\s*([^\s&]+)',
            r'api[_-]?key[=:]\s*([^\s&]+)',
            r'secret[=:]\s*([^\s&]+)',
            r'auth[=:]\s*([^\s&]+)',
            r'Authorization:\s*Bearer\s+([^\s]+)',
            r'[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}',  # Credit card-like
            r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b',  # Email
        ]
        
        # Create log directory
        AUDIT_LOG_FILE.parent.mkdir(exist_ok=True)
        INCIDENT_LOG_FILE.parent.mkdir(exist_ok=True)
    
    def redact_sensitive_data(self, text: str) -> str:
        """Redact sensitive information from text"""
        redacted = text
        for pattern in self.redaction_patterns:
            redacted = re.sub(pattern, lambda m: f"{m.group(0)[:4]}...[REDACTED]", redacted)
        return redacted
    
    async def log_event(
        self,
        event_type: SecurityEventType,
        threat_level: ThreatLevel,
        source: str,
        description: str,
        user_id: Optional[int] = None,
        session_id: Optional[str] = None,
        ip_address: Optional[str] = None,
        details: Optional[Dict[str, Any]] = None,
        action_taken: Optional[str] = None,
        correlation_id: Optional[str] = None
    ) -> str:
        """
        Log security event with comprehensive details
        """
        # Redact sensitive information
        redacted_description = self.redact_sensitive_data(description)
        redacted_details = {}
        
        if details:
            for key, value in details.items():
                if isinstance(value, str):
                    redacted_details[key] = self.redact_sensitive_data(value)
                else:
                    redacted_details[key] = value
        
        # Generate event ID
        event_id = hashlib.sha256(
            f"{source}{event_type.value}{time.time()}".encode()
        ).hexdigest()[:16]
        
        # Create security event
        event = SecurityEvent(
            event_id=event_id,
            event_type=event_type,
            timestamp=datetime.now(),
            threat_level=threat_level,
            source=source,
            user_id=user_id,
            session_id=session_id,
            ip_address=ip_address,
            description=redacted_description,
            details=redacted_details,
            action_taken=action_taken,
            correlation_id=correlation_id
        )
        
        # Store event
        self.events.append(event)
        
        # Write to file based on threat level
        log_entry = self._format_log_entry(event)
        
        # Always log to audit log
        await self._write_to_file(AUDIT_LOG_FILE, log_entry)
        
        # Log incidents to separate file
        if threat_level >= ThreatLevel.HIGH:
            await self._write_to_file(INCIDENT_LOG_FILE, log_entry)
        
        # Console output for critical events
        if threat_level >= ThreatLevel.CRITICAL:
            print(f"🔴 CRITICAL SECURITY EVENT: {event.description}")
        
        return event_id
    
    def _format_log_entry(self, event: SecurityEvent) -> str:
        """Format log entry for file storage"""
        return json.dumps(event.to_dict(), ensure_ascii=False)
    
    async def _write_to_file(self, file_path: Path, content: str):
        """Write content to file asynchronously"""
        try:
            with open(file_path, 'a', encoding='utf-8') as f:
                f.write(content + '\n')
        except Exception as e:
            print(f"❌ Failed to write to log file: {e}")
    
    async def get_events(
        self,
        start_time: Optional[datetime] = None,
        end_time: Optional[datetime] = None,
        event_type: Optional[SecurityEventType] = None,
        threat_level: Optional[ThreatLevel] = None,
        source: Optional[str] = None,
        user_id: Optional[int] = None,
        limit: int = 1000
    ) -> List[SecurityEvent]:
        """Retrieve security events with filtering"""
        filtered = self.events
        
        if start_time:
            filtered = [e for e in filtered if e.timestamp >= start_time]
        if end_time:
            filtered = [e for e in filtered if e.timestamp <= end_time]
        if event_type:
            filtered = [e for e in filtered if e.event_type == event_type]
        if threat_level:
            filtered = [e for e in filtered if e.threat_level == threat_level]
        if source:
            filtered = [e for e in filtered if e.source == source]
        if user_id:
            filtered = [e for e in filtered if e.user_id == user_id]
        
        return filtered[-limit:] if limit else filtered
    
    async def generate_report(
        self,
        start_time: datetime,
        end_time: datetime
    ) -> Dict[str, Any]:
        """Generate security report for time period"""
        events = await self.get_events(start_time, end_time)
        
        # Count by event type
        event_counts = {}
        for event in events:
            event_type = event.event_type.value
            event_counts[event_type] = event_counts.get(event_type, 0) + 1
        
        # Count by threat level
        threat_counts = {}
        for event in events:
            threat_level = event.threat_level.name
            threat_counts[threat_level] = threat_counts.get(threat_level, 0) + 1
        
        # Find top sources
        source_counts = {}
        for event in events:
            source = event.source
            source_counts[source] = source_counts.get(source, 0) + 1
        
        # Find critical events
        critical_events = [
            event for event in events 
            if event.threat_level >= ThreatLevel.HIGH
        ]
        
        report = {
            "period": {
                "start": start_time.isoformat(),
                "end": end_time.isoformat()
            },
            "total_events": len(events),
            "event_type_distribution": event_counts,
            "threat_level_distribution": threat_counts,
            "top_sources": dict(sorted(source_counts.items(), key=lambda x: x[1], reverse=True)[:10]),
            "critical_events_count": len(critical_events),
            "critical_events": [
                {
                    "event_id": e.event_id,
                    "timestamp": e.timestamp.isoformat(),
                    "source": e.source,
                    "description": e.description[:100] + "..." if len(e.description) > 100 else e.description
                }
                for e in critical_events[:20]
            ],
            "generated_at": datetime.now().isoformat()
        }
        
        return report

