    def _summarize_phase_results(self, results: Dict[str, AgentResult]) -> Dict[str, Any]:
        """Create summary of phase results"""
        total = len(results)
        completed = len([r for r in results.values() if r.status == AgentStatus.COMPLETED])
        failed = len([r for r in results.values() if r.status == AgentStatus.FAILED])
        blocked = len([r for r in results.values() if r.status == AgentStatus.BLOCKED])
        
        return {
            "total_agents": total,
            "completed": completed,
            "failed": failed,
            "blocked": blocked,
            "success_rate": (completed / total * 100) if total > 0 else 0,
        }
    
