    async def _harden_exception_handling(self):
        """Harden exception handling across the application"""
        print("  🛡️ Hardening exception handling...")
        
        # Create exception sanitizer decorator
        def sanitize_exceptions(func):
            @wraps(func)
            async def wrapper(*args, **kwargs):
                try:
                    return await func(*args, **kwargs)
                except Exception as e:
                    # Sanitize exception information
                    sanitized_error = self._sanitize_exception(e)
                    
                    # Log the sanitized error
                    if self.audit_logger:
                        await self.audit_logger.log_event(
                            event_type=SecurityEventType.EXCEPTION,
                            threat_level=ThreatLevel.MEDIUM,
                            source=self.agent_id,
                            description="Exception sanitized",
                            details={
                                "function": func.__name__,
                                "error_type": type(e).__name__,
                                "sanitized_error": str(sanitized_error)
                            }
                        )
                    
                    # Re-raise sanitized exception
                    raise sanitized_error
            
            return wrapper
        
        self.security_patches.append({
            "patch": "exception_sanitizer",
            "description": "Sanitizes exceptions to prevent information leakage",
            "decorator": sanitize_exceptions
        })
        
        self.metrics["exceptions_sanitized"] += 1
        print("  ✅ Exception handling hardened")
    
    def _sanitize_exception(self, exception: Exception) -> Exception:
        """Sanitize exception to prevent information leakage"""
        # Create a generic exception
        error_message = str(exception)
        
        # Remove sensitive information
        patterns_to_remove = [
            r'password[=:]\s*[^\s&]+',
            r'token[=:]\s*[^\s&]+',
            r'api[_-]?key[=:]\s*[^\s&]+',
            r'secret[=:]\s*[^\s&]+',
            r'Authorization:\s*Bearer\s+[^\s]+',
            r'[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}',
            r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b',
        ]
        
        for pattern in patterns_to_remove:
            error_message = re.sub(pattern, '[REDACTED]', error_message)
        
        # Remove file paths and system information
        error_message = re.sub(r'File "[^"]+"', 'File "[REDACTED]"', error_message)
        error_message = re.sub(r'line \d+', 'line [REDACTED]', error_message)
        
        # Create new exception with sanitized message
        return type(exception)(f"Sanitized error: {error_message[:200]}")
    
